<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="v1_006_create_favorites_table" author="Maxim Mashnin">
        <createTable tableName="favorites">
            <column name="user_id" type="uuid">
                <constraints nullable="false" deleteCascade="true"/>
            </column>
            <column name="recipe_id" type="uuid">
                <constraints nullable="false" deleteCascade="true"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="favorites" columnNames="user_id, recipe_id" constraintName="pk_users_recipes"/>
        <addForeignKeyConstraint
                baseTableName="favorites"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_favorites_user"
                onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="favorites"
                baseColumnNames="recipe_id"
                referencedTableName="recipes"
                referencedColumnNames="id"
                constraintName="fk_favorites_recipe"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>