<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="v1_007_create_recipe_steps_table" author="Maxim Mashnin">
        <createTable tableName="recipe_steps">
            <column name="id" type="integer" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="description" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="step_number" type="smallint">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="varchar(500)"/>
            <column name="recipe_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="recipe_steps" columnNames="recipe_id, step_number"
                             constraintName="uk_recipe_steps_number"/>
        <addForeignKeyConstraint
                baseTableName="recipe_steps"
                baseColumnNames="recipe_id"
                referencedTableName="recipes"
                referencedColumnNames="id"
                constraintName="fk_recipe_steps_recipe"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>