<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="v1_003_create_users_roles_table" author="Maxim Mashnin">
        <createTable tableName="users_roles">
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="smallint">
                <constraints nullable="false" foreignKeyName="fk_users_roles_role" references="roles(id)"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="users_roles" columnNames="user_id, role_id" constraintName="pk_users_roles"/>
        <addForeignKeyConstraint baseTableName="users_roles"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 constraintName="fk_users_roles_user"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>